          if(!e.target.closest('.bookmark-btn')) openArticleModal(item.id);
        };

        card.innerHTML = `
          <div class="w-full sm:w-44 h-32 flex-shrink-0 overflow-hidden rounded-md relative">
            <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            <span class="absolute top-2 left-2 bg-detikBlue text-white text-[10px] font-bold px-2 py-0.5 rounded shadow">${item.region}</span>
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] text-gray-500 mb-1">
                <span class="text-detikRed font-bold uppercase tracking-wider">${item.category}</span>
                <span>${item.date}</span>
              </div>
              <h4 class="font-bold text-sm sm:text-base text-gray-900 group-hover:text-detikBlue transition leading-snug line-clamp-2">${item.title}</h4>
              <p class="text-xs text-gray-600 mt-1 line-clamp-2">${item.excerpt}</p>
            </div>
            <div class="flex items-center justify-between mt-3 text-xs text-gray-500">
              <span class="text-[11px]"><i class="fa-regular fa-user mr-1"></i> ${item.author}</span>
              <button onclick="toggleBookmark(${item.id})" class="bookmark-btn text-gray-400 hover:text-detikRed transition" title="Simpan Berita">
                <i class="${isSaved ? 'fa-solid text-detikRed' : 'fa-regular'} fa-bookmark"></i>
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderPopularNews() {
      const container = document.getElementById('popularNewsContainer');
      container.innerHTML = '';
      newsData.slice(0, 5).forEach((item, index) => {
        const itemEl = document.createElement('div');
        itemEl.className = "flex items-start gap-3 cursor-pointer group";
        itemEl.onclick = () => openArticleModal(item.id);
        itemEl.innerHTML = `
          <span class="font-brand text-2xl font-black text-detikBlue/30 group-hover:text-detikRed transition w-6 text-center">#${index + 1}</span>
          <div class="flex-1 border-b border-gray-100 pb-3">
            <span class="text-[10px] font-bold text-detikRed uppercase">${item.category}</span>
            <h5 class="text-xs font-bold text-gray-800 group-hover:text-detikBlue transition line-clamp-2 leading-snug">${item.title}</h5>
          </div>
        `;
        container.appendChild(itemEl);
      });
    }

    function filterCategory(cat) {
      const filterStatus = document.getElementById('filterStatus');
      const filterKeyword = document.getElementById('filterKeyword');

      if (cat === 'all') {
        filterStatus.classList.add('hidden');
        renderNewsFeed(newsData);
      } else {
        filterKeyword.innerText = cat;
        filterStatus.classList.remove('hidden');
        const filtered = newsData.filter(item => 
          item.category.toLowerCase() === cat.toLowerCase()
        );
        renderNewsFeed(filtered);
      }
    }

    function handleSearch(e) {
      if (e.key === 'Enter') executeSearch();
    }

    function executeSearch() {
      const query = document.getElementById('searchInput').value.trim().toLowerCase();
      if (!query) {
        filterCategory('all');
        return;
      }
      document.getElementById('filterKeyword').innerText = `"${query}"`;
      document.getElementById('filterStatus').classList.remove('hidden');

      const results = newsData.filter(item => 
        item.title.toLowerCase().includes(query) || 
        item.excerpt.toLowerCase().includes(query)
      );
      renderNewsFeed(results);
    }

    function openArticleModal(id) {
      const article = newsData.find(item => item.id === id);
      if (!article) return;

      activeModalArticleId = id;
      document.getElementById('modalCategory').innerText = `${article.category} • ${article.region}`;
      document.getElementById('modalTitle').innerText = article.title;
      document.getElementById('modalAuthor').innerText = article.author;
      document.getElementById('modalDate').innerText = article.date;
      document.getElementById('modalImage').src = article.image;
      document.getElementById('modalBody').innerHTML = article.content;

      renderModalComments(article.comments);

      document.getElementById('articleModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeArticleModal() {
      document.getElementById('articleModal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    function renderModalComments(comments) {
      const listContainer = document.getElementById('modalCommentsList');
      document.getElementById('modalCommentCount').innerText = comments.length;
      listContainer.innerHTML = '';

      if (comments.length === 0) {
        listContainer.innerHTML = `<p class="text-xs text-gray-400 italic">Belum ada komentar.</p>`;
        return;
      }

      comments.forEach(c => {
        const div = document.createElement('div');
        div.className = "bg-gray-50 p-2.5 rounded border border-gray-200 text-xs";
        div.innerHTML = `
          <div class="flex items-center justify-between font-bold text-gray-800 mb-1">
            <span>${c.name}</span>
            <span class="text-[10px] text-gray-400">Baru saja</span>
          </div>
          <p class="text-gray-600">${c.text}</p>
        `;
        listContainer.appendChild(div);
      });
    }

    function addComment() {
      const input = document.getElementById('commentInput');
      const val = input.value.trim();
      if (!val) return;

      const article = newsData.find(item => item.id === activeModalArticleId);
      if (article) {
        article.comments.unshift({ name: "Pembaca Kawanua", text: val });
        renderModalComments(article.comments);
        input.value = '';
        openToast('Komentar berhasil dikirim');
      }
    }

    function toggleBookmark(id) {
      const index = savedBookmarks.indexOf(id);
      if (index > -1) {
        savedBookmarks.splice(index, 1);
        openToast('Berita dihapus dari simpanan');
      } else {
        savedBookmarks.push(id);
        openToast('Berita disimpan');
      }
      localStorage.setItem('weKawanuaBookmarks', JSON.stringify(savedBookmarks));
      updateBookmarkBadge();
      renderNewsFeed(newsData);
    }

    function updateBookmarkBadge() {
      const badge = document.getElementById('bookmarkBadge');
      if (savedBookmarks.length > 0) {
        badge.innerText = savedBookmarks.length;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function openBookmarksModal() {
      const list = document.getElementById('bookmarksList');
      list.innerHTML = '';

      if (savedBookmarks.length === 0) {
        list.innerHTML = `<p class="text-xs text-gray-500 text-center py-6">Belum ada berita tersimpan.</p>`;
      } else {
        savedBookmarks.forEach(id => {
          const item = newsData.find(n => n.id === id);
          if (item) {
            const div = document.createElement('div');
            div.className = "flex items-center justify-between p-2 border border-gray-200 rounded text-xs hover:bg-gray-50";
            div.innerHTML = `
              <span class="font-bold text-gray-800 line-clamp-1 flex-1 cursor-pointer" onclick="closeBookmarksModal(); openArticleModal(${item.id})">${item.title}</span>
              <button onclick="toggleBookmark(${item.id}); openBookmarksModal();" class="text-detikRed ml-2 font-bold text-xs"><i class="fa-solid fa-trash"></i></button>
            `;
            list.appendChild(div);
          }
        });
      }

      document.getElementById('bookmarksModal').classList.remove('hidden');
    }

    function closeBookmarksModal() {
      document.getElementById('bookmarksModal').classList.add('hidden');
    }

    function openToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.remove('hidden');
      setTimeout(() => { toast.classList.add('hidden'); }, 3000);
    }
  </script>
</body>
</html>
